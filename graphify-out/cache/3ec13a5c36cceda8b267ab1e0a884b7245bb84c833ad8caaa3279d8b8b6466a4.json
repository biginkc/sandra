tion ActivityRowView({ event }: { event: ActivityRow }) {\n  const meta = formatEvent(event);\n  const Icon = meta.icon;\n  const inner = (\n    <div className=\"flex items-start gap-3\">\n      <span\n        className={cn(\n          \"flex size-7 shrink-0 items-center justify-center rounded-full\",\n          meta.iconBg,\n        )}\n        aria-hidden\n      >\n        <Icon className={cn(\"size-4\", meta.iconColor)} />\n      </span>\n      <div className=\"min-w-0 flex-1\">\n        <div className=\"text-foreground text-sm font-medium leading-snug\">\n          {meta.summary}\n        </div>\n        <RelativeTime iso={event.at} className=\"text-xs\" />\n      </div>\n    </div>\n  );\n\n  if (meta.href) {\n    return (\n      <Link\n        href={meta.href}\n        className=\"-mx-2 block rounded-lg px-2 py-1.5 hover:bg-stone-50\"\n      >\n        {inner}\n      </Link>\n    );\n  }\n\n  return <div className=\"-mx-2 px-2 py-1.5\">{inner}</div>;\n}\n\ntype EventMeta = {\n  icon: ComponentType<{ className?: string }>;\n  iconBg: string;\n  iconColor: string;\n  summary: string;\n  href?: string;\n};\n\nfunction formatEvent(event: ActivityRow)", "source_file": "/Users/jarradhenry/Sites/Sandra/src/app/(dashboard)/dashboard/_components/activity-feed.tsx", "source_location": "L32"}, {"caller_nid": "activity_feed_activityfeed", "callee": "map", "source_file": "/Users/jarradhenry/Sites/Sandra/src/app/(dashboard)/dashboard/_components/activity-feed.tsx", "source_location": "L35"}, {"caller_nid": "activity_feed_truncate", "callee": "slice", "source_file": "/Users/jarradhenry/Sites/Sandra/src/app/(dashboard)/dashboard/_components/activity-feed.tsx", "source_location": "L143"}]}