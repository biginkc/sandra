# Sandra URL and authentication rollout
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dropbox Sign eSign integration. All four values are server-only and must
# never use a NEXT_PUBLIC_ prefix. Generate the two secret keys independently;
# the client ID and embedded domain come from the Dropbox Sign API app.
ESIGN_CREDENTIAL_ENCRYPTION_KEY=
DROPBOX_SIGN_CALLBACK_SECRET_KEY=
DROPBOX_SIGN_CLIENT_ID=
DROPBOX_SIGN_EMBEDDED_DOMAIN=
ESIGN_EMBEDDED_TEMPLATE_MANAGEMENT_ENABLED=false

# Optional Dropbox Chooser app key for selecting a PDF. Leave unset to keep
# Chooser unavailable; direct Browse upload remains the primary path.
NEXT_PUBLIC_DROPBOX_CHOOSER_APP_KEY=

# Softphone transport: unset disables calling; "simulated" is for local/explicit
# preview use; "jitter" enables the real Jitter-backed browser softphone.
NEXT_PUBLIC_SOFTPHONE_TRANSPORT=
NEXT_PUBLIC_SOFTPHONE_ALLOW_SIMULATED=
# Full-screen live-call coach overlay: set to "1" to opt in. Unset keeps the
# classic dialer popover as the live-call view (default off).
NEXT_PUBLIC_COACH_UI_ENABLED=
# Sandra server -> Jitter internal softphone API. These two values are
# server-only and must never use a NEXT_PUBLIC_ prefix.
JITTER_SOFTPHONE_BASE_URL=
JITTER_SOFTPHONE_SERVICE_TOKEN=
# Sandra Vercel -> Jitter Vercel recording playback proxy. Use the stable HTTPS
# Jitter origin and configure the same generated bearer on those two Vercel
# projects. Railway does not consume this bearer. These values are server-only
# and must never use a NEXT_PUBLIC_ prefix.
JITTER_API_BASE_URL=
JITTER_SANDRA_PLAYBACK_TOKEN=
# Sandra-only MAC key for caller-bound call capabilities. Values are
# versioned as v1:<random key>. During rotation, keep exactly one prior key.
SOFTPHONE_CAPABILITY_KEY=
SOFTPHONE_CAPABILITY_KEY_PREVIOUS=

# Sendillo SMS. All values are server-only and must never use a NEXT_PUBLIC_
# prefix. SENDILLO_CONNECTION_ID is a stable, nonsecret identity for this
# configured provider connection; keep it unchanged when rotating the API key.
# SENDILLO_ORG_ID fences the shared provider connection to its owning Sandra
# organization. Rep sender inventory and assignment fail closed when it is
# missing or does not match the requested organization.
MESSAGING_PROVIDER=
SENDILLO_API_KEY=
SENDILLO_FROM_NUMBER=
SENDILLO_WEBHOOK_SECRET=
SENDILLO_CONNECTION_ID=
# Legacy deployment alias for SENDILLO_CONNECTION_ID; prefer the canonical name.
SENDILLO_PROVIDER_ACCOUNT_ID=
SENDILLO_ORG_ID=

# Set to 1 only in a deployment whose custom:hugo provider and redirects have
# passed preflight. When unset, the existing password login remains available.
NEXT_PUBLIC_HUGO_SSO=
# Full Hugo admin URL used by Sandra's Team page for account/access management.
NEXT_PUBLIC_HUGO_URL=

# Slack OAuth (Phase 04 - task assignment DMs)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
OAUTH_STATE_SIGNING_SECRET=

# Google Calendar OAuth (Phase 04 - task event sync)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Lead-detail property imagery. The static key is sent only in signed Google
# image URLs and must be API- and browser/domain-restricted. Metadata and
# signing values are server-only and must never use NEXT_PUBLIC_ prefixes.
GOOGLE_MAPS_STATIC_KEY=
GOOGLE_STREET_VIEW_METADATA_KEY=
GOOGLE_MAPS_URL_SIGNING_SECRET=

# OAuth token encryption (Phase 04 - pgcrypto pgp_sym_encrypt key)
# Generate locally with: openssl rand -hex 32
OAUTH_TOKEN_ENCRYPTION_KEY=

# Internal homeowner practice (server-only; configure the same owned DID in Jitter).
# Apply the training call-purpose migration BEFORE enabling. Empty/invalid values deny access.
# Keep the reserved number configured when disabling so it cannot become a customer call.
HOMEOWNER_TRAINING_ENABLED=false
HOMEOWNER_TRAINING_NUMBER=
HOMEOWNER_TRAINING_OPERATOR_IDS=

# Public training access; normal app/provider authentication still applies.
HOMEOWNER_TRAINING_PUBLIC_ACCESS=false

# Server-only, independently verified shared Dropbox Sign billing allowances.
# JSON keyed by provider account ID; omit for the default API-specific quota.
# Each entry: {"basis":"shared_signature_requests","plan":"Essentials 50",
# "allowance":50,"verifiedAt":"ISO timestamp","validUntil":"ISO timestamp"}.
# Reverify against billing before expiry (maximum verification window: 32 days).
DROPBOX_SIGN_QUOTA_POLICIES=
# Sentry error reporting (set DSNs in deployment environment)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional: source map uploads in CI (keep this secret)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Long-lived Sentry repair runner (configure only on its isolated service).
# The database path must point at a mounted durable volume, for example
# /data/repair.db. GitHub publishing is disabled unless explicitly enabled;
# the GitHub App settings belong only to the controller service.
SANDRA_REPAIR_VOLUME_PATH=/data
SANDRA_REPAIR_DB_PATH=/data/repair.db
SANDRA_GITHUB_PUBLISH_ENABLED=false
SANDRA_GITHUB_REPOSITORY=biginkc/sandra
SANDRA_GITHUB_PUBLISHER_OWNER=sandra-controller
# Set these only when publication is approved. Keep the private key in the
# controller secret store; never pass it to workers or put it in source.
SANDRA_GITHUB_APP_ID=
SANDRA_GITHUB_INSTALLATION_ID=
SANDRA_GITHUB_APP_PRIVATE_KEY=
SANDRA_REPAIR_DISPATCH_ENABLED=false
SANDRA_REPAIR_POLL_SECONDS=30
