    "@vercel/functions": "3.4.4",
    "@workflow/next": "^4.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "googleapis": "^171.4.0",
    "hellosign-embedded": "2.12.3",
    "lucide-react": "^1.8.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pg-connection-string": "^2.13.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "shadcn": "^4.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "workflow": "^4.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@1password/sdk": "0.5.0",
