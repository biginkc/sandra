    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.27.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "pg": "^8.21.0",
    "postcss": "^8.5.10",
    "railway": "^3.11.0",
    "sharp": "^0.34.5",
