    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "@tanstack/db": "0.9.0",
    "@tanstack/electric-db-collection": "0.4.8",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-virtual": "3.14.12",
