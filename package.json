{
  "name": "sandra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:local": "vitest run --config vitest.local-integration.config.ts",
    "test:slack-local": "vitest run --config vitest.slack-local.config.ts",
    "test:search-oracle": "vitest run --config vitest.search-oracle.config.ts",
    "test:search-local": "vitest run --config vitest.local-integration.config.ts supabase/migrations/20261002110100_search_properties.integration.test.ts tests/search-oracle/oracle-comparison.integration.test.ts",
    "test:search-filter-local": "vitest run --config vitest.filter-local.config.ts src/lib/prospects/search-filter-composition.integration.test.ts src/lib/prospects/search-eval-budget.integration.test.ts",
    "test:search-volume": "SEARCH_VOLUME=1 vitest run --config vitest.search-volume.config.ts",
    "test:inbox-ro-fixture": "node --test --test-concurrency=1 scripts/inbox-test-readonly-fixture.test.mjs",
    "test:norma-stress": "vitest run --config vitest.norma-stress.config.ts",
    "test:outbox-unit": "vitest run --config vitest.outbox.config.ts scripts/outbox-owned-rows.test.ts --maxWorkers=1 --no-file-parallelism && node --test scripts/outbox-run-record.test.mjs",
    "test:outbox-regression": "node scripts/outbox-run-record.mjs",
    "test:rtl": "vitest run --config vitest.rtl.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:synthetic": "playwright test --config playwright.synthetic.config.ts",
    "test:e2e:prod-canary": "playwright test --config playwright.canary.config.ts",
    "test:e2e:properties-filter": "playwright test --config playwright.properties-filter.config.ts",
    "verify:hugo-sql": "node scripts/verify-hugo-access-migrations.mjs",
    "verify:hugo-rollback": "SANDRA_HUGO_VERIFY_LANE=rollback-roundtrip node scripts/verify-hugo-access-migrations.mjs",
    "verify:migration-safety-unit": "node --test scripts/check-migration-safety.test.mjs",
    "verify:migration-safety-rehearsal": "LC_ALL=C node scripts/check-migration-safety.rehearsal.mjs",
    "verify:sms-opening-identity": "node scripts/rehearse-sms-opening-identity-migration.mjs",
    "verify:esign-atomic-packet": "node --test scripts/apply-esign-production-migrations-atomically.test.mjs",
    "verify:esign-essentials-rehearsal": "node scripts/rehearse-esign-essentials-production-path.mjs",
    "verify:esign-draft-restart-mutations": "node scripts/verify-esign-draft-restart-mutations.mjs",
    "verify:esign-navigation-history-mutations": "node scripts/verify-esign-navigation-history-mutations.mjs",
    "verify:csv-import-migration": "LC_ALL=C node scripts/rehearse-csv-import-truthfulness.mjs",
    "verify:promote-leads-migration": "LC_ALL=C node scripts/rehearse-promote-leads.mjs",
    "verify:leads-urgency-sql": "LC_ALL=C bash scripts/rehearse-leads-urgency-paging.sh",
    "verify:migrate-prod-ref-guard": "bash scripts/assert-ref-is-main-or-ancestor.test.sh",
    "my-leads-close:kpi-snapshot": "node scripts/my-leads-close/kpi-snapshot.mjs",
    "my-leads-close:kpi-compare": "node scripts/my-leads-close/kpi-compare.mjs",
    "my-leads-close:lease-manifest": "node scripts/my-leads-close/lease-manifest.mjs",
    "stress": "tsx e2e/stress/cli.ts",
    "test:stress-unit": "vitest run --config vitest.stress.config.ts",
    "test:my-leads-close-unit": "vitest run scripts/my-leads-close e2e/support/my-leads-close-fixture.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:sms-opening-identity && npm run verify:esign-atomic-packet && npm run verify:esign-essentials-rehearsal && npm run verify:calculators-migration && npm run typecheck && npm run test && npm run test:rtl",
    "filters:characterize:pass1": "tsx scripts/properties-filter-characterization.ts",
    "prepare": "husky",
    "smoke:sequences-prod": "tsx scripts/smoke-sequences-prod.ts",
    "smoke:ai-happy-prod": "tsx scripts/smoke-ai-responder-happy-prod.ts",
    "smoke:ai-escalation-prod": "tsx scripts/smoke-ai-responder-escalation-prod.ts",
    "smoke:stop-prod": "tsx scripts/smoke-stop-keyword-prod.ts",
    "smoke:sendillo-webhook-prod": "tsx scripts/smoke-sendillo-webhook-prod.ts",
    "verify:calculators-migration": "LC_ALL=C node scripts/rehearse-offer-calculations.mjs"
  },
  "dependencies": {
