{
  "name": "sandra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:rtl": "vitest run --config vitest.rtl.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:prod-canary": "playwright test --config playwright.canary.config.ts",
    "test:e2e:properties-filter": "playwright test --config playwright.properties-filter.config.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run test:rtl",
    "filters:characterize:pass1": "tsx scripts/properties-filter-characterization.ts",
    "prepare": "husky",
    "smoke:sequences-prod": "tsx scripts/smoke-sequences-prod.ts",
    "smoke:ai-happy-prod": "tsx scripts/smoke-ai-responder-happy-prod.ts",
    "smoke:ai-escalation-prod": "tsx scripts/smoke-ai-responder-escalation-prod.ts",
    "smoke:stop-prod": "tsx scripts/smoke-stop-keyword-prod.ts",
    "smoke:sendillo-webhook-prod": "tsx scripts/smoke-sendillo-webhook-prod.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sandra/tokens": "github:biginkc/sandra-design-system#main",
    "@slack/web-api": "^7.15.2",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "@workflow/next": "^4.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "workflow": "^4.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
