# Production contract only. Inject the role verifier/credential at deployment
# time from the approved secret store; no password belongs in this file.
INBOX_ELECTRIC_DATABASE_URL=postgresql://inbox_electric_replication@db.copflsklaefwzipsrjqz.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/etc/sandra-inbox/supabase-prod-ca-2021.crt&ssl_min_protocol_version=TLSv1.2&gssencmode=disable
INBOX_ELECTRIC_PGPASSFILE=/run/secrets/sandra-inbox-electric-pgpass
INBOX_ELECTRIC_DATABASE_HOST=db.copflsklaefwzipsrjqz.supabase.co
INBOX_ELECTRIC_DATABASE_PORT=5432
INBOX_ELECTRIC_DATABASE_NAME=postgres
INBOX_ELECTRIC_DATABASE_SSLMODE=verify-full
INBOX_ELECTRIC_DATABASE_SSLROOTCERT=/etc/sandra-inbox/supabase-prod-ca-2021.crt
INBOX_ELECTRIC_DATABASE_SSL_MIN_PROTOCOL_VERSION=TLSv1.2
INBOX_ELECTRIC_DATABASE_GSSENCMODE=disable
INBOX_ELECTRIC_MANUAL_TABLE_PUBLISHING=true
INBOX_ELECTRIC_REPLICATION_STREAM_ID=inbox_copflsklaefwzipsrjqz
