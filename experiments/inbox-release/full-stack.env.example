# Copy to an ignored work file, export INBOX_RELEASE_RUNTIME_ENV_FILE and
# source the file before `docker compose --profile full-runtime ... config`.
# Every value below is a placeholder and must remain absent from git.
INBOX_RESTATE_PRIVATE_KEY_FILE=work/inbox-release-restate-private.pem
INBOX_ELECTRIC_DATABASE_URL=postgres://inbox_electric_replication:REPLACE@db:5432/postgres?sslmode=disable
# Manual publication is created by the reviewed database packet. The release
# proof uses its own stream suffix, which must match its release publication.
ELECTRIC_MANUAL_TABLE_PUBLISHING=true
ELECTRIC_REPLICATION_STREAM_ID=inbox_release_20260917
INBOX_ACTION_DATABASE_URL=postgres://inbox_action_worker:REPLACE@127.0.0.1:54322/postgres
INBOX_REPLY_SEND_DATABASE_URL=postgres://inbox_reply_send_worker:REPLACE@127.0.0.1:54322/postgres
INBOX_RESTATE_IDENTITY_KEYS=[]
INBOX_RELEASE_OPERATION_REGISTRATION_PATH=/runtime/REPLACE_WITH_64_LOWERCASE_HEX_DIGEST
INBOX_RELEASE_REPLY_REGISTRATION_PATH=/runtime/REPLACE_WITH_64_LOWERCASE_HEX_DIGEST
INBOX_RELAY_TOKEN=REPLACE_WITH_A_RANDOM_FIXTURE_TOKEN
